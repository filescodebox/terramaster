[en-us]
name = "PigeonBox File Locker"
auth = "PigeonBox"
descript = "PigeonBox runs in a Docker container on your NAS: share files with a pickup code, and pick up what others shared with you."
release_note = "1. Initial release."
important = "Requires DockerEngine to be installed and enabled from the TOS App Center. Docker images must come from Docker Hub."

